# Ollama (native API, powered by the `ollama-client` gem)
# Local Ollama needs no API key. For Ollama Cloud, set OLLAMA_BASE_URL to
# https://ollama.com and OLLAMA_API_KEY (or a comma-separated OLLAMA_API_KEYS pool).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Reasoning and embedding models
NEMESIS_REASONING_MODEL=gemma4:31b
NEMESIS_EMBED_MODEL=nomic-embed-text

# Binance Futures — use testnet first
BINANCE_KEY=paper
BINANCE_SECRET=paper
BINANCE_REST=https://testnet.binancefuture.com
BINANCE_WS=wss://stream.binancefuture.com

# Episodic memory (optional — in-memory fallback when unset)
QDRANT_URL=
QDRANT_API_KEY=

# Redis working memory (optional)
REDIS_URL=redis://localhost:6379/0

# Trading desk
NEMESIS_EQUITY=10000
NEMESIS_SYMBOL=btcusdt
NEMESIS_PAPER_MODE=true
NEMESIS_LLM_ENABLED=false

# Logging
VERBOSE_LOGS=false
